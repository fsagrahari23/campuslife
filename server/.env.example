# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://gatepass:gatepass_secret@localhost:5432/gatepass

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=gatepass-server

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-please
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Ed25519 Keys (generate with: npm run generate-keys)
ED25519_PRIVATE_KEY=
ED25519_PUBLIC_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
